{
  "name": "tkoh-display-player",
  "version": "2.0.1",
  "description": "TKOH hospital display kiosk player for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis"
  },
  "author": "TKOH",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "hk.org.ha.tkoh.displayplayer",
    "productName": "Room Display Player Demo",
    "files": [
      "main.js",
      "displayUrl.js",
      "loading.html",
      "settings.html",
      "settingsPreload.js",
      "config.json",
      "icon.ico",
      "WiseSystem_icon.svg"
    ],
    "directories": {
      "buildResources": "build"
    },
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "icon.ico",
        "to": "WiseSystem.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "Room Display Player Demo ${version}.${ext}"
    },
    "nsis": {
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Room Display Player Demo",
      "include": "installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}
